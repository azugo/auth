# Development configuration for the example portal. Loaded by godotenv in
# cmd/server/main.go; real environment variables take precedence.
ENVIRONMENT=development
SERVER_URLS=http://0.0.0.0:8080

AUTH_SECRET=insecure-example-portal-secret-0123456789

# Primary signing key (insecure dev-only EC P-256): enables id_token issuance.
AUTH_KEYS_PRIMARY="-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgi+Wqybd+q+3hPpXT
la4J7wOg//63FaAEuvy0c5ukhRyhRANCAATJyWTPlh9DBpWGBlu+WuCOngXwjeG9
VlgRuzIaEDSzQGU/VeKgraHh7JmyaikoEWN7v8/RKcmwy5h4HIyqqSyg
-----END PRIVATE KEY-----"

# Shared secret for the example push MFA webhook (POST /auth/mfa/push/callback).
PUSH_CALLBACK_SECRET=insecure-example-push-callback-secret
