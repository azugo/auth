package views

// PasswordErrors holds the validation message shown under each password field.
type PasswordErrors struct {
	Current string
	New     string
	Confirm string
}

// Password renders the password form; current asks for the current password, which a login
// held at pending_password_change does not have to give.
templ Password(current bool, returnTo string, errs PasswordErrors) {
	@layout("Change password") {
		if !current {
			<p>You must set a new password before you can continue.</p>
		}
		<form method="post" action="/password">
			if returnTo != "" {
				<input type="hidden" name="return_to" value={ returnTo }/>
			}
			if current {
				<label for="current_password">Current password</label>
				<input id="current_password" name="current_password" type="password" autocomplete="current-password" required/>
				@fieldError(errs.Current)
			}
			<label for="new_password">New password</label>
			<input id="new_password" name="new_password" type="password" autocomplete="new-password" required/>
			@fieldError(errs.New)
			<label for="confirm_password">Confirm new password</label>
			<input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required/>
			@fieldError(errs.Confirm)
			if current {
				<label><input type="checkbox" name="keep_other_sessions" value="1"/> Stay signed in on other devices</label>
			}
			<button type="submit">Save</button>
		</form>
		if current {
			<p><a href="/security">Back to security</a></p>
		} else {
			<p><a href="/login">Start over</a></p>
		}
	}
}
