// Package views holds the templ templates for the example portal.
package views

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				body { font-family: sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1rem; }
				form { display: grid; gap: .75rem; max-width: 20rem; }
				input { padding: .5rem; }
				button { padding: .5rem; cursor: pointer; }
				.error { color: #b00020; }
			</style>
		</head>
		<body>
			<h1>{ title }</h1>
			{ children... }
		</body>
	</html>
}
